# Example only. No credentials are committed with this project.
# Production values belong in the Vercel project's environment settings.
# Local development values go in an ignored .env.local file.
SITE_ORIGIN=https://your-store.example

# Install Turso Cloud through the Vercel Marketplace and connect the database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Connect a public Vercel Blob store for product and editorial images.
BLOB_READ_WRITE_TOKEN=

# First administrator only. Generate a random key of at least 32 characters,
# keep it in Vercel's secret environment settings, and enter it at /admin.
# Set ALLOW_OWNER_SETUP=false and remove the key after creating the account.
ALLOW_OWNER_SETUP=false
OWNER_SETUP_SECRET=

# Optional Resend key and verified sender. With no key, live email stays queued.
EMAIL_API_KEY=
EMAIL_FROM=

# Wallet/card providers are deliberately unregistered. Do not add merchant
# secrets until a reviewed provider adapter and signed webhooks are implemented.
